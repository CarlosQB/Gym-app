# Copia este archivo a .env.local y rellena los valores desde Supabase → Project Settings → API.
# La anon key es pública por diseño (la seguridad la da RLS), pero NO subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: nombre para el saludo
NEXT_PUBLIC_USER_NAME=
